<?xml version="1.0"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <globalization requestEncoding="UTF-8" responseEncoding="UTF-8" fileEncoding="UTF-8" culture="zh-TW" uiCulture="zh-TW"/>
    <!-- requestValidationMode="4.5"：啟用延遲式請求驗證。沒有這行的話，驗證是舊版(2.0)的
         立即觸發模式，連框架自己在 Page.DeterminePostBackMode() 內部存取 Request.Form
         都會立刻丟 HttpRequestValidationException，此時頁面本身的 ValidateRequest="false"
         （見 NewsPost.aspx）根本還來不及生效，XSS 這題會連 Postback 都打不進去。 -->
    <httpRuntime requestValidationMode="4.5" targetFramework="4.8"/>
  </system.web>
  <connectionStrings>
    <add name="H2C_Portal_DB" 
         connectionString="Data Source=127.0.0.1;Initial Catalog=H2C_Portal;User ID=h2c;Password=h2c;Integrated Security=False" 
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>